            
<ScreenManager>:
    HomeScreen:
    ShumScreen:

<HomeScreen>:
            

<ShumScreen>
    name: "ShumScreen"
    BoxLayout:
        orientation: "vertical"
        padding: [20, 0, 20, 0]

        Button:
            id: the_button
            text: ""
            on_press: root.change_screen()
            halign: 'center'
            valign: 'middle'
            color: 0, 0, 0, 1
            background_color: 0, 0, 0, 0
            text_size: self.width, None
   
            font_size: self.width * 0.1 if self.texture_size[0] > self.width else '16sp'
            
            
           
            
